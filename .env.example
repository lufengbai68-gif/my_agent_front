# ---- 生成服务 ----
# 'true' 或不设置 = Mock 适配器（无需任何后端）
# 'false' = 真实 API 适配器
VITE_USE_MOCK=true

# 真实适配器：你自己的服务端代理地址。
# ⚠️ 不要填火山引擎即梦 API 直连地址——官方 API 需要 HMAC 签名（含 SecretKey，
# 绝不能进浏览器）且受 CORS 限制，必须由后端代理转发。
VITE_API_BASE_URL=

# 代理的 Bearer Token（仅用于你自己的代理，不存放火山密钥）
VITE_API_KEY=

# ---- 调优 ----
# 任务轮询间隔（毫秒，默认 1500）
VITE_POLL_INTERVAL_MS=1500
